 arch/arm64/configs/redmi_a5_defconfig         |   1 +
 drivers/power/supply/Kconfig                  |   9 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/sgm41513_charger.c       | 341 ++++++++++++++++++
 5 files changed, 374 insertions(+)
 create mode 100644 drivers/power/supply/sgm41513_charger.c

diff --git a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
index c5b096c83..2364a2dda 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
@@ -241,6 +241,8 @@ &agcp_dma {
  */
 &pmic_typec_pd {
 	status = "okay";
+	/* 5 V fuer OTG-Geraete (Rd) aus dem Ladechip, schaltet TCPM selbst */
+	vbus-supply = <&otg_vbus>;
 
 	connector {
 		compatible = "usb-c-connector";
@@ -253,3 +255,23 @@ connector {
 		op-sink-microwatt = <10000000>;
 	};
 };
+
+/ {
+	aliases {
+		/* i2c-sprd nimmt die Busnummer aus dem Alias */
+		i2c2 = &i2c2;
+	};
+};
+
+&i2c2 {
+	status = "okay";
+
+	charger@1a {
+		compatible = "sgmicro,sgm41513";
+		reg = <0x1a>;
+
+		otg_vbus: usb-otg-vbus {
+			regulator-name = "otg-vbus";
+		};
+	};
+};
