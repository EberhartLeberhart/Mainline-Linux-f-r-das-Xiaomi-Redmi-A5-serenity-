From ecc5e47281195cb8cfbeb0a3da5bcda6e345f947 Mon Sep 17 00:00:00 2001
From: EberhartLeberhart <eberhartleberhart585@gmail.com>
Date: Sun, 22 Nov 2026 19:28:49 +0100
Subject: [PATCH 61/62] pmdomain: sprd: register domains with their real power
 state

sprd_pmu_add_one_domain() powers every domain on, but registered it with genpd as off. genpd then never switched it off again (measured on AP_VSP: genpd 'off', PMU state 0x00 = powered). Register the domain as on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W8YQkFAqgbw689knydrHtG
---
 drivers/pmdomain/sprd/pm-domains.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/sprd/pm-domains.c b/drivers/pmdomain/sprd/pm-domains.c
index 6b04f8159..939ddba75 100644
--- a/drivers/pmdomain/sprd/pm-domains.c
+++ b/drivers/pmdomain/sprd/pm-domains.c
@@ -164,7 +164,12 @@ generic_pm_domain *sprd_pmu_add_one_domain(struct sprd_pmu *pmu, struct device_n
 	if (SPRD_PD_CAPS(pd, SPRD_PD_ACTIVE_WAKEUP))
 		pd->genpd.flags |= GENPD_FLAG_ACTIVE_WAKEUP;
 
-	pm_genpd_init(&pd->genpd, NULL, true);
+	/*
+	 * The domain was powered on above, so register it as on. Otherwise
+	 * genpd believes it is off while the hardware is powered, and with
+	 * pd_ignore_unused it is never switched off at all.
+	 */
+	pm_genpd_init(&pd->genpd, NULL, false);
 
 	pmu->domains[id] = &pd->genpd;
 
