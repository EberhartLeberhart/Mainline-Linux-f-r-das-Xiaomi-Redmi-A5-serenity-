 };
 
 struct sprd_pcm_dma_private {
@@ -31,6 +33,9 @@ struct sprd_pcm_dma_private {
 	struct sprd_pcm_dma_data data[SPRD_PCM_CHANNEL_MAX];
 	int hw_chan;
 	int dma_addr_offset;
