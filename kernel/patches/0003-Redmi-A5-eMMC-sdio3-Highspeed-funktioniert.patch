From e8e715ab6723f852f2c80c06735502297f84436f Mon Sep 17 00:00:00 2001
From: EberhartLeberhart <eberhartleberhart585@gmail.com>
Date: Sun, 27 Sep 2026 18:35:49 +0200
Subject: [PATCH 03/15] Redmi A5: eMMC (sdio3, Highspeed) funktioniert

---
 .../boot/dts/sprd/ums9230-xiaomi-serenity.dts      | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
index b6ce25b9e..b621e4edb 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
@@ -20,6 +20,7 @@ / {
 	aliases {
 		serial0 = &uart0;
 		serial1 = &uart1;
+		mmc0 = &sdio3;
 	};
 
 	chosen {
@@ -135,3 +136,16 @@ key-power {
 
 &uart0 { status = "okay"; };
 &uart1 { status = "okay"; };
+
+/* eMMC - erst mal nur Highspeed (52 MHz), ohne HS200/HS400 */
+&sdio3 {
+	bus-width = <8>;
+	non-removable;
+	no-sdio;
+	no-sd;
+	no-1-8-v;
+	cap-mmc-highspeed;
+	cap-mmc-hw-reset;
+	sprd,phy-delay-mmc-highspeed = <0x60 0x2e 0x2c 0x2c>;
+	status = "okay";
+};
-- 
