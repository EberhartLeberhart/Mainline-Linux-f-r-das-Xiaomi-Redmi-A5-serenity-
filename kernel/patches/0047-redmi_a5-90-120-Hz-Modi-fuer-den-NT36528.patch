From 7915c00578fb4b4c40cd6406144465dd1b41509b Mon Sep 17 00:00:00 2001
From: farrizdesignpro1339 <garenafreefiremax1339@gmail.com>
Date: Sat, 14 Nov 2026 08:09:25 +0700
Subject: [PATCH] drm/panel-novatek: 90/120-Hz Modi fuer den NT36528

Der Panel hat lt. Xiaomis Timing-Tabelle neben dem native 60-Hz-Timing
noch einen 90-Hz- (vfront-porch 999) und einen 120-Hz-Timing (vfront-porch 331).
Beide unterscheiden sich nur im vertikalen Blanking; Takt (199,2 MHz),
hsync und htotal bleiben gleich.

- 60 Hz (PREFERRED): vtotal 4010 -> fps 60.0
- 90 Hz (DRIVER):     vtotal 2673 -> fps 90.07
- 120 Hz (DRIVER):    vtotal 2005 -> fps 120.0

Die Modi werden DRM_MODE_TYPE_DRIVER gemeldet; sichtbar bei
"cat /sys/class/drm/cardX-eDP-1/modes" und per
"kscreen-doctor output.1.mode.720x1640@120.000000" setzbar.

Der bevorzugte Modus bleibt 60 Hz (native) - der Nutzer entscheidet,
ob 90/120 Hz oder 60 Hz.
---
 drivers/gpu/drm/panel/panel-novatek-nt36528.c | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36528.c b/drivers/gpu/drm/panel/panel-novatek-nt36528.c
index b188ec904d4e..35ee1cf83a66 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt36528.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36528.c
@@ -400,6 +400,34 @@ static const struct drm_display_mode nt36528_modes[] = {
 		.height_mm = 160,
 		.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
 	},
+	{
+		.clock = 199200,
+		.hdisplay = 720,
+		.hsync_start = 720 + 24,
+		.hsync_end = 720 + 24 + 4,
+		.htotal = 720 + 24 + 4 + 80,
+		.vdisplay = 1640,
+		.vsync_start = 1640 + 999,
+		.vsync_end = 1640 + 999 + 2,
+		.vtotal = 1640 + 999 + 2 + 32,
+		.width_mm = 70,
+		.height_mm = 160,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
+	{
+		.clock = 199200,
+		.hdisplay = 720,
+		.hsync_start = 720 + 24,
+		.hsync_end = 720 + 24 + 4,
+		.htotal = 720 + 24 + 4 + 80,
+		.vdisplay = 1640,
+		.vsync_start = 1640 + 331,
+		.vsync_end = 1640 + 331 + 2,
+		.vtotal = 1640 + 331 + 2 + 32,
+		.width_mm = 70,
+		.height_mm = 160,
+		.type = DRM_MODE_TYPE_DRIVER,
+	},
 };
 
 /* Panel_C3Z_36_10_0d_vid timing0 (native-mode): 186,2 MHz, h 720+62+4+50 = 836, v 1640+2036+4+32 = 3712 */
-- 
