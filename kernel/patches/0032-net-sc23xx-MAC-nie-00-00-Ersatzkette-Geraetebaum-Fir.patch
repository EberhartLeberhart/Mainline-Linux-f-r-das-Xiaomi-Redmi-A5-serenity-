From 0bc115e530d72832d86dbd56072a52df2eb9858c Mon Sep 17 00:00:00 2001
From: EberhartLeberhart <eberhartleberhart585@gmail.com>
Date: Wed, 4 Nov 2026 14:28:57 +0100
Subject: [PATCH] net: sc23xx: MAC nie 00:00 - Ersatzkette
 Geraetebaum/Firmware/Chip-Kennung/Zufall

- bisher: MAC nur aus local-mac-address (unter Android vom Bootloader
  eingetragen, bei uns leer) -> wlan0 = 00:00:00:00:00:00, CMD_OPEN
  schickt Nullen, Firmware nimmt still ihre eigene MAC, Router adressiert
  eine andere MAC als wlan0 (EAPOL kam nie bei wpa_supplicant an)
- jetzt: Geraetebaum -> Firmware (GET_INFO, falls angehaengt) -> feste
  MAC aus der Chip-Kennung (nvmem-cells uid-start/uid-end, Ableitung aus
  beebonos rg-rotate-Fassung, GPL-2.0-only) -> Zufall mit Warnung;
  Meldung "MAC-Quelle: ..." beim Start
- Beleg Redmi A5 04.11.: MAC-Quelle Chip-Kennung, nach Neustart gleich,
  WPA2 + DHCP + Ping ohne Handgriff

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W8YQkFAqgbw689knydrHtG
---
 drivers/net/wireless/unisoc/cmd.c    | 13 +++++
 drivers/net/wireless/unisoc/main.c   | 84 +++++++++++++++++++++++++++-
 drivers/net/wireless/unisoc/sc23xx.h |  1 +
 3 files changed, 97 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/unisoc/cmd.c b/drivers/net/wireless/unisoc/cmd.c
index bfe1a2e1c..684f82b55 100644
--- a/drivers/net/wireless/unisoc/cmd.c
+++ b/drivers/net/wireless/unisoc/cmd.c
@@ -949,6 +949,19 @@ int sc23xx_get_fw_info(struct sc23xx_dev *sdev)
 			wiphy_dbg(sdev->wiphy, "FW rts_threshold: %d\n", val);
 			sdev->wiphy->rts_threshold = val;
 		}
+
+		/*
+		 * Nach info_1 und info_2 haengt die Firmware ihre eingebaute MAC an (6 Bytes, danach 1 Byte
+		 * Credit-Faehigkeit; wie Android sprdwl und beebonos rg-rotate-Fassung). Nur als Ersatz
+		 * nehmen, wenn der Geraetebaum keine gueltige MAC liefert: Sonst schickt sc23xx_cmd_open()
+		 * 00:00:00:00:00:00, die Firmware meldet sich still mit ihrer eigenen MAC an und kein an sie
+		 * adressierter Rahmen (EAPOL!) wird von Linux angenommen (Beleg Redmi A5, 04.11.2026).
+		 */
+		if (!is_valid_ether_addr(sdev->mac_addr) && rskb->len >= ETH_ALEN &&
+		    is_valid_ether_addr(rskb->data)) {
+			ether_addr_copy(sdev->mac_addr, rskb->data);
+			sdev->mac_src = "Firmware";
+		}
 	}
 
 	dev_kfree_skb(rskb);
diff --git a/drivers/net/wireless/unisoc/main.c b/drivers/net/wireless/unisoc/main.c
index 378692bb2..c20dc7b3b 100644
--- a/drivers/net/wireless/unisoc/main.c
+++ b/drivers/net/wireless/unisoc/main.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/firmware.h>
+#include <linux/nvmem-consumer.h>
 #include <linux/rtnetlink.h>
 
 #include "sc23xx.h"
@@ -415,7 +416,10 @@ void *sc23xx_alloc_device(struct device *dev, size_t size,
 	sdev = wiphy_priv(wiphy);
 	sdev->wiphy = wiphy;
 	sdev->bus_ops = bus_ops;
-	device_get_mac_address(dev, sdev->mac_addr);
+	if (!device_get_mac_address(dev, sdev->mac_addr) && is_valid_ether_addr(sdev->mac_addr))
+		sdev->mac_src = "Geraetebaum";
+	else
+		eth_zero_addr(sdev->mac_addr);
 
 	sdev->evt_wq = alloc_ordered_workqueue("%s-events", 0,
 					       wiphy_name(wiphy));
@@ -575,6 +579,65 @@ int sc23xx_load_config(struct sc23xx_dev *sdev, const char *fw_name)
 }
 EXPORT_SYMBOL_GPL(sc23xx_load_config);
 
+/*
+ * Feste, je Geraet eindeutige MAC aus der Chip-Kennung (UID im eFuse-Spiegel; beim UMS9230 laut
+ * Android-Geraetebaum qogirl6.dtsi cache_efuse 0x65014c00, uid-start@5c, uid-end@58). Uebernommen aus
+ * beebonos rg-rotate-Fassung dieses Treibers (sc23xx_read_uid/sc23xx_mac_addr_from_uid, GPL-2.0-only,
+ * github.com/beebono/linux-mainline-sprd), dort fuer den UMS512. Ergebnis ist lokal verwaltet
+ * (Bit 1 im ersten Byte), damit sie sich nie mit einer Hersteller-MAC ueberschneidet.
+ */
+static int sc23xx_read_uid(struct device *dev, u8 uid[8])
+{
+	static const char * const names[2] = { "uid-end", "uid-start" };
+	struct nvmem_cell *cell;
+	size_t len;
+	void *buf;
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		cell = nvmem_cell_get(dev, names[i]);
+		if (IS_ERR(cell))
+			return PTR_ERR(cell);
+
+		buf = nvmem_cell_read(cell, &len);
+		nvmem_cell_put(cell);
+		if (IS_ERR(buf))
+			return PTR_ERR(buf);
+		if (len < 4) {
+			kfree(buf);
+			return -EINVAL;
+		}
+
+		memcpy(uid + i * 4, buf, 4);
+		kfree(buf);
+	}
+
+	return 0;
+}
+
+static int sc23xx_mac_addr_from_uid(struct device *dev, u8 *addr)
+{
+	u8 uid[8];
+	int ret;
+
+	ret = sc23xx_read_uid(dev, uid);
+	if (ret)
+		return ret;
+
+	/* alle 8 UID-Bytes in die 6 Bytes der Adresse falten (wie beebono) */
+	addr[0] = uid[0] ^ uid[6];
+	addr[1] = uid[1] ^ uid[7];
+	addr[2] = uid[2];
+	addr[3] = uid[3];
+	addr[4] = uid[4];
+	addr[5] = uid[5] ^ 0x0f;
+
+	/* lokal verwaltet, Unicast */
+	addr[0] = (addr[0] & 0xfe) | 0x02;
+
+	return is_valid_ether_addr(addr) ? 0 : -EINVAL;
+}
+
 int sc23xx_register_device(struct sc23xx_dev *sdev)
 {
 	struct sc23xx_vif *vif;
@@ -586,6 +649,25 @@ int sc23xx_register_device(struct sc23xx_dev *sdev)
 		return ret;
 	}
 
+	/* dritte Stufe: feste MAC aus der Chip-Kennung (braucht nvmem-cells uid-start/uid-end im DT) */
+	if (!is_valid_ether_addr(sdev->mac_addr)) {
+		ret = sc23xx_mac_addr_from_uid(wiphy_dev(sdev->wiphy), sdev->mac_addr);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		if (!ret)
+			sdev->mac_src = "Chip-Kennung (UID, fest)";
+		else
+			eth_zero_addr(sdev->mac_addr);
+	}
+
+	/* letzte Rueckfallebene: nie mit 00:00:00:00:00:00 arbeiten (siehe sc23xx_get_fw_info()) */
+	if (!is_valid_ether_addr(sdev->mac_addr)) {
+		eth_random_addr(sdev->mac_addr);
+		sdev->mac_src = "Zufall (weder Geraetebaum, Firmware noch Chip-Kennung lieferten eine MAC)";
+		wiphy_warn(sdev->wiphy, "keine gueltige MAC gefunden - nehme eine zufaellige\n");
+	}
+	wiphy_info(sdev->wiphy, "MAC-Quelle: %s\n", sdev->mac_src);
+
 	ret = wiphy_register(sdev->wiphy);
 	if (ret) {
 		wiphy_err(sdev->wiphy, "failed to register wiphy\n");
diff --git a/drivers/net/wireless/unisoc/sc23xx.h b/drivers/net/wireless/unisoc/sc23xx.h
index 5f6e25ee8..6ada5cb67 100644
--- a/drivers/net/wireless/unisoc/sc23xx.h
+++ b/drivers/net/wireless/unisoc/sc23xx.h
@@ -97,6 +97,7 @@ struct sc23xx_dev {
 	char country_code[2];
 
 	u8 mac_addr[ETH_ALEN];
+	const char *mac_src;	/* woher mac_addr stammt (nur fuer die Meldung beim Start) */
 	struct ieee80211_supported_band band_2ghz;
 	struct ieee80211_supported_band band_5ghz;
 	u8 max_mc_mac_addrs;
-- 
