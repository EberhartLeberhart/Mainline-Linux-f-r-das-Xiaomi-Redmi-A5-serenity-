diff --git a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
new file mode 100644
index 000000000..b6ce25b9e
--- /dev/null
+++ b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/* Xiaomi Redmi A5 (serenity) - minimal, Konsole auf simple-framebuffer */
+/dts-v1/;
+#include <dt-bindings/input/input.h>
+#include "ums9230.dtsi"
+#include "sc2730.dtsi"
+
+#ifndef FB_BASE
+#define FB_BASE 0x9caa8000
+#endif
+#define FB_WIDTH  720
+#define FB_HEIGHT 1640
+#define FB_SIZE   (FB_WIDTH * FB_HEIGHT * 4)
+
+/ {
+	model = "Xiaomi Redmi A5";
+	compatible = "xiaomi,serenity", "sprd,ums9230";
+	sprd,sc-id = "ums9230 1000 1000";
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@0 {
+			compatible = "simple-framebuffer";
+			reg = <0 (FB_BASE + 0x482000) 0 0x481200>; /* Display zeigt Puffer 2 */
+			width = <FB_WIDTH>;
+			height = <FB_HEIGHT>;
+			stride = <(FB_WIDTH * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		framebuffer_region: framebuffer-region@0 {
+			compatible = "framebuffer";
+			reg = <0 FB_BASE 0 0x13d8000>;
+			no-map;
+		};
+
+		/* aus dem Live-Device-Tree von Android uebernommen */
+		ddrbist@80000000 {
+			reg = <0 0x80000000 0 0x1000>;
+			no-map;
+		};
+		sysdumpinfo@80001000 {
+			reg = <0 0x80001000 0 0x1000>;
+			no-map;
+		};
+		pdbg@80002000 {
+			reg = <0 0x80002000 0 0x1000>;
+			no-map;
+		};
+		protected@80003000 {
+			reg = <0 0x80003000 0 0x2000>;
+			no-map;
+		};
+		wcn@87000000 {
+			reg = <0 0x87000000 0 0x800000>;
+			no-map;
+		};
+		sp-ddr@88000000 {
+			reg = <0 0x88000000 0 0x300000>;
+			no-map;
+		};
+		audiodsp@88f00000 {
+			reg = <0 0x88f00000 0 0x700000>;
+			no-map;
+		};
+		cp@89600000 {
+			reg = <0 0x89600000 0 0x4900000>;
+			no-map;
+		};
+		sipc@8e000000 {
+			reg = <0 0x8e000000 0 0x900000>;
+			no-map;
+		};
+		audio@94100000 {
+			reg = <0 0x94100000 0 0x300000>;
+			no-map;
+		};
+		uboot-log@9de80000 {
+			reg = <0 0x9de80000 0 0x80000>;
+			no-map;
+		};
+		sml@b0000000 {
+			reg = <0 0xb0000000 0 0x40000>;
+			no-map;
+		};
+		tos@b0040000 {
+			reg = <0 0xb0040000 0 0x3820000>;
+			no-map;
+		};
+		sh@b6000000 {
+			reg = <0 0xb6000000 0 0x100000>;
+			no-map;
+		};
+		secured@ff870000 {
+			reg = <0 0xff870000 0 0x200000>;
+			no-map;
+		};
+		faceid@ffa70000 {
+			reg = <0 0xffa70000 0 0x500000>;
+			no-map;
+		};
+		rebootescrow@fff70000 {
+			reg = <0 0xfff70000 0 0x10000>;
+			no-map;
+		};
+
+		ramoops@fff80000 {
+			compatible = "ramoops";
+			reg = <0 0xfff80000 0 0x40000>;
+			record-size = <0x8000>;
+			console-size = <0x8000>;
+			pmsg-size = <0x8000>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		key-power {
+			debounce-interval = <2>;
+			gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+		};
+	};
+};
+
+&uart0 { status = "okay"; };
+&uart1 { status = "okay"; };
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87a822e5c..5db7d8998 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -82,7 +82,101 @@
 	 *  x20        primary_entry() .. __primary_switch()    CPU boot mode
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
+/* REDMI-DEBUG: Bildspeicher bei ausgeschalteter MMU einfaerben */
+	.macro redmi_paint, color
+	mov_q	x9, 0x9caa8000
+	mov_q	x10, 0x9de80000
+	mov_q	x11, \color
+9992:	str	w11, [x9], #4
+	cmp	x9, x10
+	b.lo	9992b
+	dsb	sy
+	.endm
 SYM_CODE_START(primary_entry)
+	/* REDMI-DEBUG: Bildspeicher magenta fuellen (MMU aus, physische Adresse) */
+	mov_q	x9, 0x9caa8000
+	mov_q	x10, 0x9de80000
+	mov_q	x11, 0xffff00ff
+9991:	str	w11, [x9], #4
+	cmp	x9, x10
+	b.lo	9991b
+	dsb	sy
+	/* REDMI-CACHE: kompletten Daten-Cache per set/way zurueckschreiben + verwerfen */
+	mov	x12, x0
+	mov	x13, x1
+	mov	x14, x2
+	mov	x15, x3
+	dmb	sy
+	mrs	x0, clidr_el1
+	and	x3, x0, #0x7000000
+	lsr	x3, x3, #23
+	cbz	x3, 9985f
+	mov	x10, #0
+9981:	add	x2, x10, x10, lsr #1
+	lsr	x1, x0, x2
+	and	x1, x1, #7
+	cmp	x1, #2
+	b.lt	9984f
+	msr	csselr_el1, x10
+	isb
+	mrs	x1, ccsidr_el1
+	and	x2, x1, #7
+	add	x2, x2, #4
+	mov	x4, #0x3ff
+	and	x4, x4, x1, lsr #3
+	clz	w5, w4
+	mov	x7, #0x7fff
+	and	x7, x7, x1, lsr #13
+9982:	mov	x9, x4
+9983:	lsl	x6, x9, x5
+	orr	x11, x10, x6
+	lsl	x6, x7, x2
+	orr	x11, x11, x6
+	dc	cisw, x11
+	subs	x9, x9, #1
+	b.ge	9983b
+	subs	x7, x7, #1
+	b.ge	9982b
+9984:	add	x10, x10, #2
+	cmp	x3, x10
+	b.gt	9981b
+9985:	mov	x10, #0
+	msr	csselr_el1, x10
+	dsb	sy
+	ic	iallu
+	dsb	sy
+	isb
+	mov	x0, x12
+	mov	x1, x13
+	mov	x2, x14
+	mov	x3, x15
+	/* REDMI: dunkelblau = Cache geleert */
+	mov_q	x9, 0x9caa8000
+	mov_q	x10, 0x9de80000
+	mov_q	x11, 0xff000080
+9986:	str	w11, [x9], #4
+	cmp	x9, x10
+	b.lo	9986b
+	dsb	sy
+	/* REDMI-DELAY: 10 Sekunden warten (Hardware-Timer), dann grau */
+	mrs	x9, cntfrq_el0
+	cbz	x9, 9988f
+	mov	x10, #10
+	mul	x9, x9, x10
+	isb
+	mrs	x10, cntpct_el0
+	add	x9, x9, x10
+9987:	isb
+	mrs	x10, cntpct_el0
+	cmp	x10, x9
+	b.lo	9987b
+9988:	mov_q	x9, 0x9caa8000
+	mov_q	x10, 0x9de80000
+	mov_q	x11, 0xff808080
+9989:	str	w11, [x9], #4
+	cmp	x9, x10
+	b.lo	9989b
+	dsb	sy
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
@@ -119,6 +213,7 @@ SYM_CODE_START(primary_entry)
 1:	mov	x0, x19
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
+	redmi_paint 0xff008080		// REDMI: tuerkis = nach init_kernel_el
 
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
@@ -127,6 +222,7 @@ SYM_CODE_START(primary_entry)
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+	redmi_paint 0xff804000		// REDMI: braun = vor MMU-Einschalten
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 23c05dc7a..b14f141d2 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -278,6 +278,53 @@ u64 cpu_logical_map(unsigned int cpu)
 	return __cpu_logical_map[cpu];
 }
 
+
+/* REDMI-DEBUG: Bildspeicher frueh einfaerben */
+#include <linux/sizes.h>
+
+/* REDMI-DEBUG: Bildschirm schwarz, dann k weisse Querstreifen im sichtbaren Puffer */
+void redmi_fill_phys(unsigned long start, unsigned long end, u32 c)
+{
+	unsigned long off, len, i;
+	void __iomem *p;
+	for (off = start; off < end; off += len) {
+		len = min_t(unsigned long, SZ_128K, end - off);
+		p = early_ioremap(off, len);
+		if (!p)
+			return;
+		for (i = 0; i + 4 <= len; i += 4)
+			writel_relaxed(c, p + i);
+		early_iounmap(p, len);
+	}
+	wmb();
+}
+void redmi_stripes_bg(int k, u32 bg)
+{
+	unsigned long base = 0x9cf2a000UL, stride = 720 * 4;
+	int i;
+	redmi_fill_phys(0x9caa8000UL, 0x9de80000UL, bg);
+	for (i = 0; i < k; i++)
+		redmi_fill_phys(base + (i * 150) * stride, base + (i * 150 + 100) * stride, 0xffffffff);
+}
+
+void redmi_stripes(int k) { redmi_stripes_bg(k, 0xff000000); }
+
+static void __init redmi_early_paint(u32 c)
+{
+	unsigned long base = 0x9caa8000UL, size = 0x13d8000UL, off, len, i;
+	void __iomem *p;
+	for (off = 0; off < size; off += SZ_128K) {
+		len = min_t(unsigned long, SZ_128K, size - off);
+		p = early_ioremap(base + off, len);
+		if (!p)
+			return;
+		for (i = 0; i < len; i += 4)
+			writel_relaxed(c, p + i);
+		early_iounmap(p, len);
+	}
+	wmb();
+}
+
 void __init __no_sanitize_address setup_arch(char **cmdline_p)
 {
 	setup_initial_init_mm(_text, _etext, _edata, _end);
@@ -288,6 +335,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	early_fixmap_init();
 	early_ioremap_init();
+	redmi_early_paint(0xff00ffff);
 
 	setup_machine_fdt(__fdt_pointer);
 
@@ -332,16 +380,20 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	arm64_memblock_init();
 
 	paging_init();
+	redmi_early_paint(0xffff8000);
 
 	acpi_table_upgrade();
 
 	/* Parse the ACPI tables for possible boot-time configuration */
 	acpi_boot_table_init();
+	redmi_stripes_bg(1, 0xffff0000);	/* rot+1: nach ACPI */
 
 	if (acpi_disabled)
 		unflatten_device_tree();
 
+	redmi_early_paint(0xffff69b4);	/* rosa: DT ausgepackt */
 	bootmem_init();
+	redmi_early_paint(0xffffffff);	/* weiss: bootmem fertig */
 
 	kasan_init();
 
@@ -357,7 +409,9 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	arm64_rsi_init();
 
 	init_bootcpu_ops();
+	redmi_early_paint(0xffffff00);	/* gelb: PSCI fertig */
 	smp_init_cpus();
+	redmi_early_paint(0xff80ff00);	/* hellgruen: CPUs erfasst */
 	smp_build_mpidr_hash();
 
 #ifdef CONFIG_ARM64_SW_TTBR0_PAN
