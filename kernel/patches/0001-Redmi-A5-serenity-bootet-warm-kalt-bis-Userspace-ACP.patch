diff --git a/drivers/of/fdt.c b/drivers/of/fdt.c
index 82f7327c5..c98d6794f 100644
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -348,6 +348,12 @@ static int unflatten_dt_nodes(const void *blob,
  * Return: NULL on failure or the memory chunk containing the unflattened
  * device tree on success.
  */
+
+/* REDMI-DEBUG */
+void redmi_stripes(int k);
+void redmi_stripes_bg(int k, u32 bg);
+#define REDMI_MARK(k) do { if (!slab_is_available()) redmi_stripes(k); } while (0)
+
 void *__unflatten_device_tree(const void *blob,
 			      struct device_node *dad,
 			      struct device_node **mynodes,
@@ -378,8 +384,10 @@ void *__unflatten_device_tree(const void *blob,
 		return NULL;
 	}
 
+	REDMI_MARK(1);
 	/* First pass, scan for size */
