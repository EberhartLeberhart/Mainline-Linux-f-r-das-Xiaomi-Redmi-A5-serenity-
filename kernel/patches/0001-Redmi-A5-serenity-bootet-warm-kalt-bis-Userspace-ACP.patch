diff --git a/init/main.c b/init/main.c
index 96f93bb06..b579c7e0d 100644
--- a/init/main.c
+++ b/init/main.c
@@ -121,6 +121,80 @@
 
 static int kernel_init(void *);
 
+/* REDMI-DEBUG: sofortiger Neustart an Stufe N, wenn "redmi_reset=N" in CONFIG_CMDLINE */
+#include <linux/arm-smccc.h>
+
+/* REDMI-DEBUG: Bildschirm je Stufe einfaerben (Logobuffer bei 0x9caa8000, 20 MB) */
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#define REDMI_FB_BASE 0x9caa8000UL
+#define REDMI_FB_SIZE 0x13d8000UL
+static void __init redmi_fill(void __iomem *p, unsigned long len, u32 c)
+{
+	unsigned long i;
+	for (i = 0; i < len; i += 4)
+		writel_relaxed(c, p + i);
+}
+static void __init redmi_mark(int stage)
+{
+	static const u32 col[] = { 0, 0xffff0000, 0xff00ff00, 0xff0000ff, 0xffffff00, 0xffffffff };
+	unsigned long off, len;
+	void __iomem *p;
+	if (stage < 1 || stage > 5)
+		return;
+	if (!slab_is_available()) {
+		for (off = 0; off < REDMI_FB_SIZE; off += SZ_128K) {
+			len = min_t(unsigned long, SZ_128K, REDMI_FB_SIZE - off);
+			p = early_ioremap(REDMI_FB_BASE + off, len);
+			if (!p)
+				return;
+			redmi_fill(p, len, col[stage]);
+			early_iounmap(p, len);
+		}
+	} else {
+		p = ioremap(REDMI_FB_BASE, REDMI_FB_SIZE);
+		if (!p)
+			return;
+		redmi_fill(p, REDMI_FB_SIZE, col[stage]);
+		iounmap(p);
+	}
+	wmb();
+}
+
+
+static void __init redmi_slices(void)
+{
+	static const u32 col[] = { 0xffffffff, 0xffffff00, 0xff000000, 0xffff69b4, 0xff808080 };
+	unsigned long slice = 720UL * 1640 * 4, off, len;
+	void __iomem *p;
+	int k;
+	p = ioremap(REDMI_FB_BASE, REDMI_FB_SIZE);
+	if (!p)
+		return;
+	for (off = 0, k = 0; off < REDMI_FB_SIZE; off += slice, k++) {
+		len = min_t(unsigned long, slice, REDMI_FB_SIZE - off);
+		redmi_fill(p + off, len, col[min(k, 4)]);
+	}
+	iounmap(p);
+	wmb();
+}
+
+void redmi_stripes_bg(int k, u32 bg);
+
+static void __init redmi_check(int stage)
+{
+#ifdef CONFIG_CMDLINE
+	static const char *const keys[] = {
+		"redmi_reset=0", "redmi_reset=1", "redmi_reset=2",
+		"redmi_reset=3", "redmi_reset=4", "redmi_reset=5" };
+	struct arm_smccc_res res;
+	if (stage >= 0 && stage < 6 && strstr(CONFIG_CMDLINE, keys[stage]))
+		arm_smccc_smc(0x84000009, 0, 0, 0, 0, 0, 0, 0, &res); /* PSCI SYSTEM_RESET */
+#endif
+}
