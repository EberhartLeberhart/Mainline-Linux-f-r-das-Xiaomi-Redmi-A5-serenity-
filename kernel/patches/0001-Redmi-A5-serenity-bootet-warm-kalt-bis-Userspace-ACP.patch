+	REDMI_MARK(2);
 	if (size <= 0)
 		return NULL;
 
@@ -388,10 +396,12 @@ void *__unflatten_device_tree(const void *blob,
 
 	/* Allocate memory for the expanded device tree */
 	mem = dt_alloc(size + 4, __alignof__(struct device_node));
+	REDMI_MARK(3);
 	if (!mem)
 		return NULL;
 
 	memset(mem, 0, size);
+	REDMI_MARK(4);
 
 	*(__be32 *)(mem + size) = cpu_to_be32(0xdeadbeef);
 
@@ -399,6 +409,7 @@ void *__unflatten_device_tree(const void *blob,
 
 	/* Second pass, do actual unflattening */
 	ret = unflatten_dt_nodes(blob, mem, dad, mynodes);
+	REDMI_MARK(5);
 
 	if (be32_to_cpup(mem + size) != 0xdeadbeef)
 		pr_warn("End of tree marker overwritten: %08x\n",
@@ -1284,8 +1295,10 @@ void __init unflatten_device_tree(void)
 {
 	void *fdt = initial_boot_params;
 
+	redmi_stripes_bg(2, 0xffff0000);	/* rot+2 */
 	/* Save the statically-placed regions in the reserved_mem array */
 	fdt_scan_reserved_mem_late();
+	redmi_stripes_bg(3, 0xffff0000);	/* rot+3 */
 
 	/* Populate an empty root node when bootloader doesn't provide one */
 	if (!fdt) {
@@ -1305,6 +1318,7 @@ void __init unflatten_device_tree(void)
 
 	/* Get pointer to "/chosen" and "/aliases" nodes for use everywhere */
 	of_alias_scan(early_init_dt_alloc_memory_arch);
+	REDMI_MARK(6);
 
 	unittest_unflatten_overlay_base();
 }
diff --git a/drivers/spi/spi-sprd-adi.c b/drivers/spi/spi-sprd-adi.c
index 3864d9589..28aceaef5 100644
--- a/drivers/spi/spi-sprd-adi.c
+++ b/drivers/spi/spi-sprd-adi.c
@@ -389,6 +389,28 @@ static int sprd_adi_restart_sc9860(struct sys_off_data *data)
 	return sprd_adi_restart(data->cb_data, data->mode, data->cmd, &wdg);
 }
 
+
+/* REDMI: wie Android - Neustart-Modus in PMIC rst_sts (0x1bac) schreiben, dann uebernimmt PSCI */
+#define SC2730_RST_STATUS	0x1bac
+static int sprd_adi_restart_ums512(struct sys_off_data *data)
+{
+	struct sprd_adi *sadi = data->cb_data;
+	u32 val = 0, mode = 0x40;	/* normal */
+
+	if (data->cmd) {
+		if (!strncmp(data->cmd, "recovery", 8))
+			mode = 0x20;
+		else if (!strncmp(data->cmd, "bootloader", 10) ||
+			 !strncmp(data->cmd, "fastboot", 8))
+			mode = 0x30;
+	}
+	if (sprd_adi_read(sadi, SC2730_RST_STATUS, &val))
+		return NOTIFY_DONE;
+	if ((val & 0xff) != 0x2 && (val & 0xff) != 0x4)
+		sprd_adi_write(sadi, SC2730_RST_STATUS, (val & ~0xffU) | mode);
+	return NOTIFY_DONE;
+}
+
 static void sprd_adi_hw_init(struct sprd_adi *sadi)
 {
 	struct device_node *np = sadi->dev->of_node;
@@ -507,7 +529,7 @@ static int sprd_adi_probe(struct platform_device *pdev)
 		return dev_err_probe(&pdev->dev, ret, "failed to register SPI controller\n");
 
 	if (sadi->data->restart) {
-		ret = devm_register_restart_handler(&pdev->dev,
+		ret = devm_register_sys_off_handler(&pdev->dev, SYS_OFF_MODE_RESTART, 192,
 						    sadi->data->restart,
 						    sadi);
 		if (ret)
@@ -534,6 +556,7 @@ static struct sprd_adi_data ums512_data = {
 	.slave_offset = ADI_15BIT_SLAVE_OFFSET,
 	.slave_addr_size = ADI_15BIT_SLAVE_ADDR_SIZE,
 	.read_check = sprd_adi_read_check_r3,
+	.restart = sprd_adi_restart_ums512,
 };
 
 static const struct of_device_id sprd_adi_of_match[] = {
diff --git a/drivers/watchdog/sprd_wdt.c b/drivers/watchdog/sprd_wdt.c
index 4e689b6ff..36da967c5 100644
--- a/drivers/watchdog/sprd_wdt.c
+++ b/drivers/watchdog/sprd_wdt.c
@@ -244,6 +244,18 @@ static u32 sprd_wdt_get_timeleft(struct watchdog_device *wdd)
 	return val / SPRD_WDT_CNT_STEP;
 }
 
+
+/* REDMI: Neustart ueber den SoC-Watchdog, damit der Bootloader NORMAL_MODE waehlt */
+static int sprd_wdt_restart(struct watchdog_device *wdd,
+			    unsigned long action, void *data)
+{
+	wdd->pretimeout = 0;
+	wdd->timeout = 1;
+	sprd_wdt_start(wdd);
+	mdelay(3000);
+	return 0;
+}
+
 static const struct watchdog_ops sprd_wdt_ops = {
 	.owner = THIS_MODULE,
 	.start = sprd_wdt_start,
@@ -251,6 +263,7 @@ static const struct watchdog_ops sprd_wdt_ops = {
 	.set_timeout = sprd_wdt_set_timeout,
 	.set_pretimeout = sprd_wdt_set_pretimeout,
 	.get_timeleft = sprd_wdt_get_timeleft,
+	.restart = sprd_wdt_restart,
 };
 
 static const struct watchdog_info sprd_wdt_info = {
@@ -318,6 +331,7 @@ static int sprd_wdt_probe(struct platform_device *pdev)
 
 	watchdog_set_nowayout(&wdt->wdd, WATCHDOG_NOWAYOUT);
 	watchdog_init_timeout(&wdt->wdd, 0, dev);
+	watchdog_set_restart_priority(&wdt->wdd, 100);
 
 	ret = devm_watchdog_register_device(dev, &wdt->wdd);
