From fd6c59ecb134c5c7a1690142e78794256274a3e9 Mon Sep 17 00:00:00 2001
From: EberhartLeberhart <eberhartleberhart585@gmail.com>
Date: Sat, 14 Nov 2026 21:02:10 +0100
Subject: [PATCH 46/47] arm64: dts: redmi_a5: i2c2 mit
 #address-cells/#size-cells

- in Patch 0045 fehlten am i2c-Bus 2 die Angaben #address-cells = <1>
  und #size-cells = <0>; dtc (W=1) meldete reg_format/i2c_bus_bridge fuer
  charger@1a. Der Treiber lief trotzdem (i2c liest die erste Zahl)
- Beleg 14.11.: W=1 ohne Warnung zu i2c/charger; sgm41513-charger
  meldet sich weiter mit "SGM41513 rev 0"

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W8YQkFAqgbw689knydrHtG
---
 arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
index 2364a2dda..e6c0fd5b3 100644
--- a/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
+++ b/arch/arm64/boot/dts/sprd/ums9230-xiaomi-serenity.dts
@@ -264,6 +264,8 @@ aliases {
 };
 
 &i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
 	status = "okay";
 
 	charger@1a {
-- 
2.43.0

