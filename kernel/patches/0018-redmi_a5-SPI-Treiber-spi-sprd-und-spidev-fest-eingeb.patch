Date: Fri, 9 Oct 2026 16:12:43 +0200
Subject: [PATCH 18/24] redmi_a5: SPI-Treiber (spi-sprd) und spidev fest
 eingebaut - Vorbereitung Touch an spi3

---
 arch/arm64/configs/redmi_a5_defconfig | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/redmi_a5_defconfig b/arch/arm64/configs/redmi_a5_defconfig
index ce507fbc2..c5a88129c 100644
--- a/arch/arm64/configs/redmi_a5_defconfig
+++ b/arch/arm64/configs/redmi_a5_defconfig
@@ -409,7 +409,7 @@ CONFIG_SPI_PL022=y
 CONFIG_SPI_SPRD_ADI=y
 CONFIG_SPI_XILINX=m
 CONFIG_SPI_ZYNQMP_GQSPI=m
-CONFIG_SPI_SPIDEV=m
+CONFIG_SPI_SPIDEV=y
 CONFIG_SPMI=y
 CONFIG_PINCTRL=y
 CONFIG_PINCTRL_DA9062=m
@@ -1033,3 +1033,4 @@ CONFIG_CORESIGHT_STM=m
 CONFIG_CORESIGHT_CPU_DEBUG=m
 CONFIG_CORESIGHT_CTI=m
 CONFIG_MEMTEST=y
+CONFIG_SPI_SPRD=y
