From: EberhartLeberhart <eberhartleberhart585@gmail.com>
Date: Sun, 27 Sep 2026 19:28:41 +0200
Subject: [PATCH 04/24] Redmi A5: PMIC-Watchdog beim Start angehalten, Ubuntu
 laeuft dauerhaft

---
 drivers/spi/spi-sprd-adi.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/spi/spi-sprd-adi.c b/drivers/spi/spi-sprd-adi.c
index 28aceaef5..6c9a097e4 100644
--- a/drivers/spi/spi-sprd-adi.c
+++ b/drivers/spi/spi-sprd-adi.c
@@ -411,6 +411,23 @@ static int sprd_adi_restart_ums512(struct sys_off_data *data)
 	return NOTIFY_DONE;
 }
 
+
+/* REDMI: Der Bootloader schaltet den PMIC-Watchdog (SC2730, Basis 0x40) scharf.
+ * Linux hat dafuer keinen Treiber -> nach ~5 Minuten Reset. Beim Start anhalten;
+ * der SoC-Watchdog (sprd_wdt) bleibt aktiv. */
+#define SC2730_WDG_BASE		0x40
+static void sprd_adi_stop_pmic_wdt(struct sprd_adi *sadi)
+{
+	u32 val = 0;
+
+	sprd_adi_write(sadi, SC2730_WDG_BASE + REG_WDG_LOCK, WDG_UNLOCK_KEY);
+	sprd_adi_read(sadi, SC2730_WDG_BASE + REG_WDG_CTRL, &val);
+	val &= ~(BIT_WDG_RUN | BIT_WDG_RST);
+	sprd_adi_write(sadi, SC2730_WDG_BASE + REG_WDG_CTRL, val);
+	sprd_adi_write(sadi, SC2730_WDG_BASE + REG_WDG_LOCK, ~WDG_UNLOCK_KEY);
+	dev_info(sadi->dev, "REDMI: PMIC-Watchdog angehalten (ctrl=0x%x)\n", val);
+}
+
 static void sprd_adi_hw_init(struct sprd_adi *sadi)
 {
 	struct device_node *np = sadi->dev->of_node;
@@ -517,6 +534,8 @@ static int sprd_adi_probe(struct platform_device *pdev)
 	}
 
 	sprd_adi_hw_init(sadi);
+	if (of_device_is_compatible(pdev->dev.of_node, "sprd,ums512-adi"))
+		sprd_adi_stop_pmic_wdt(sadi);
 
 	ctlr->bus_num = pdev->id;
 	ctlr->num_chipselect = num_chipselect;
-- 
